{
  "name": "ocp-cli",
  "version": "2.2.0",
  "private": true,
  "description": "Command-line tools for validating and inspecting OpenChannel Protocol messages",
  "keywords": [
    "openchannel-protocol",
    "ocp",
    "cli",
    "protobuf",
    "validation"
  ],
  "homepage": "https://github.com/frontal-labs/open-channel#readme",
  "bugs": {
    "url": "https://github.com/frontal-labs/open-channel/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/open-channel.git",
    "directory": "cli"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Frontal Labs",
    "email": "support@frontal.dev",
    "url": "https://github.com/frontal-labs"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "ocp": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "node --import tsx/esm src/main.ts",
    "format": "ultracite fix src",
    "lint": "ultracite check src",
    "test": "vitest run --config vitest.config.ts --root .. cli/tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.5",
    "ocp-protocol": "workspace:*"
  },
  "devDependencies": {
    "ocp-testing": "workspace:*",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
