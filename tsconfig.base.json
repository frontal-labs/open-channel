{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "ocp-adapter": ["packages/adapter/src/index.ts"],
      "ocp-cli": ["cli/src/index.ts"],
      "ocp-core": ["packages/core/src/index.ts"],
      "ocp-policy": ["packages/policy/src/index.ts"],
      "ocp-protocol": ["packages/protocol/src/index.ts"],
      "ocp-runtime": ["packages/runtime/src/index.ts"],
      "ocp-sdk": ["sdks/typescript/src/index.ts"],
      "ocp-testing": ["packages/testing/src/index.ts"],
      "ocp-sdk/*": ["sdks/typescript/src/*/index.ts"]
    }
  }
}
