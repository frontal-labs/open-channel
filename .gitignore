# Generated protobuf bindings. Regenerate with `pnpm generate`; only the README is tracked.
/proto/gen/*
!/proto/gen/README.md

# Compiled output must never sit beside TypeScript sources: it shadows them in tests.
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
