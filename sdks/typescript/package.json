{
  "name": "ocp-sdk",
  "version": "2.0.1",
  "description": "TypeScript SDK for building OpenChannel Protocol agents and hosts",
  "keywords": [
    "ocp-protocol",
    "ocp",
    "agents",
    "agent-host",
    "a2a"
  ],
  "homepage": "https://github.com/frontal-labs/open-channel#readme",
  "bugs": {
    "url": "https://github.com/frontal-labs/open-channel/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/open-channel.git",
    "directory": "sdks/typescript"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Frontal Labs",
    "email": "support@frontal.dev",
    "url": "https://github.com/frontal-labs"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./a2a": {
      "types": "./dist/a2a/index.d.ts",
      "import": "./dist/a2a/index.js"
    },
    "./calendar": {
      "types": "./dist/calendar/index.d.ts",
      "import": "./dist/calendar/index.js"
    },
    "./cedar": {
      "types": "./dist/cedar/index.d.ts",
      "import": "./dist/cedar/index.js"
    },
    "./directory": {
      "types": "./dist/directory/index.d.ts",
      "import": "./dist/directory/index.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "import": "./dist/email/index.js"
    },
    "./google-chat": {
      "types": "./dist/google-chat/index.d.ts",
      "import": "./dist/google-chat/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./opa": {
      "types": "./dist/opa/index.d.ts",
      "import": "./dist/opa/index.js"
    },
    "./otel": {
      "types": "./dist/otel/index.d.ts",
      "import": "./dist/otel/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "import": "./dist/postgres/index.js"
    },
    "./slack": {
      "types": "./dist/slack/index.d.ts",
      "import": "./dist/slack/index.js"
    },
    "./teams": {
      "types": "./dist/teams/index.d.ts",
      "import": "./dist/teams/index.js"
    },
    "./whatsapp": {
      "types": "./dist/whatsapp/index.d.ts",
      "import": "./dist/whatsapp/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm build:bundle && pnpm build:types",
    "build:bundle": "node scripts/bundle.mjs",
    "build:types": "tsc -p tsconfig.json --noEmit --emitDeclarationOnly --declaration --outDir dist",
    "format": "ultracite fix src",
    "lint": "ultracite check src",
    "test": "vitest run --root ../.. sdks/typescript/tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "ocp-adapter": "workspace:*",
    "ocp-core": "workspace:*",
    "ocp-policy": "workspace:*",
    "ocp-protocol": "workspace:*",
    "ocp-runtime": "workspace:*",
    "ocp-testing": "workspace:*",
    "pg": "^8.23.1",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
