{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "dist",
    "paths": {
      "@openchannel/adapter": ["packages/adapter/src/index.ts"],
      "@openchannel/core": ["packages/core/src/index.ts"],
      "@openchannel/policy": ["packages/policy/src/index.ts"],
      "@openchannel/protocol": ["packages/protocol/src/index.ts"],
      "@openchannel/runtime": ["packages/runtime/src/index.ts"],
      "@openchannel/testing": ["packages/testing/src/index.ts"]
    },
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"]
}
