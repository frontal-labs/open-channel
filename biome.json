{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/vitest",
    "./ultracite.json"
  ],
  "overrides": [
    {
      "includes": ["sdks/typescript/src/**", "sdks/typescript/tests/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "off"
          }
        }
      }
    },
    {
      "includes": [
        "sdks/typescript/src/app.ts",
        "sdks/typescript/tests/channels/a2a/a2a-provider.test.ts",
        "examples/slack-typescript/src/main.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noAwaitInLoops": "off"
          }
        }
      }
    },
    {
      "includes": ["examples/slack-typescript/src/main.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
