{
  "name": "@openchannelprotocol/testing",
  "version": "0.1.0",
  "private": true,
  "description": "Testing fixtures and utilities for OpenChannel Protocol implementations",
  "keywords": [
    "openchannel-protocol",
    "ocp",
    "testing",
    "fixtures",
    "vitest"
  ],
  "homepage": "https://github.com/frontal-labs/open-channel#readme",
  "bugs": {
    "url": "https://github.com/frontal-labs/open-channel/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/open-channel.git",
    "directory": "packages/testing"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Frontal Labs",
    "email": "support@frontal.dev",
    "url": "https://github.com/frontal-labs"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "ultracite fix src tests",
    "lint": "ultracite check src tests",
    "test": "vitest run --root ../.. packages/testing/tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.5",
    "@openchannelprotocol/core": "workspace:*",
    "@openchannelprotocol/protocol": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
