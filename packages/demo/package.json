{
  "name": "@openchannel/demo",
  "version": "2.0.1",
  "private": true,
  "description": "Reference OpenChannel Protocol demo application",
  "keywords": [
    "openchannel-protocol",
    "ocp",
    "demo",
    "example"
  ],
  "homepage": "https://github.com/frontal-labs/open-channel#readme",
  "bugs": {
    "url": "https://github.com/frontal-labs/open-channel/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/open-channel.git",
    "directory": "packages/demo"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Frontal Labs",
    "email": "support@frontal.dev",
    "url": "https://github.com/frontal-labs"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "demo": "node --import tsx/esm src/main.ts",
    "format": "ultracite fix src",
    "lint": "ultracite check src",
    "test": "vitest run --root ../.. packages/demo/tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@openchannel/adapter": "workspace:*",
    "@openchannel/policy": "workspace:*",
    "@openchannel/testing": "workspace:*",
    "openchannel": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
