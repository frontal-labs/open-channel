{
  "name": "@openchannelprotocol/policy",
  "version": "0.1.0",
  "private": true,
  "description": "Authorization, approval, and policy evaluation primitives for OpenChannel Protocol runtimes",
  "keywords": [
    "openchannel-protocol",
    "ocp",
    "authorization",
    "policy",
    "approvals"
  ],
  "homepage": "https://github.com/frontal-labs/open-channel#readme",
  "bugs": {
    "url": "https://github.com/frontal-labs/open-channel/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/open-channel.git",
    "directory": "packages/policy"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Frontal Labs",
    "email": "support@frontal.dev",
    "url": "https://github.com/frontal-labs"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "ultracite fix src",
    "lint": "ultracite check src",
    "test": "vitest run --root ../.. packages/policy/tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@openchannelprotocol/protocol": "workspace:*"
  },
  "devDependencies": {
    "@openchannelprotocol/testing": "workspace:*",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
